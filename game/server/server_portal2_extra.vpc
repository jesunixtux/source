// Additional Portal 2 entity sources. The base Portal project is included by WAF.
$Macro SRCDIR "..\.."
$Configuration
{
    $Compiler
    {
        $AdditionalIncludeDirectories ".\portal2;$SRCDIR\game\shared\portal2"
        $PreprocessorDefinitions "PORTAL2;PORTAL2_DLL"
    }
}
$Project "Portal 2 extensions"
{
    $File "portal2\npc_personality_core.cpp"
    $File "portal2\npc_wheatley_boss.cpp"
    $File "portal2\prop_button.cpp"
    $File "portal2\prop_button_base.cpp"
    $File "portal2\prop_floor_button.cpp"
    $File "portal2\prop_floor_button_base.cpp"
    $File "portal2\prop_floor_button_under.cpp"
    $File "portal2\prop_testchamber_door.cpp"
    $File "portal2\prop_under_button.cpp"
    $File "portal2\prop_weighted_cube.cpp"
    $File "portal2\portal2_map_compat.cpp"
    $File "portal2\portal2_entity_compat.cpp"
    $File "portal2\portal2_intro_script.cpp"
    $File "portal2\portal2_viewproxy.cpp"
    $File "portal2\portal2_gameplay_test.cpp"
    $File "portal2\paint_database.cpp"
    $File "portal2\portal_playerlocaldata.cpp"
    $File "portal2\func_portalled.cpp"
}
